---
/*
 * «Преимущества» — почему выбирают нас. Скелет заморожен, LLM даёт title/desc/icon.
 *   grid    — сетка иконка-карточек (→ карусель на мобилке)
 *   cards   — крупные карточки с рамкой и тенью (→ карусель на мобилке)
 *   inline  — компактные строки «иконка + текст» в 2 колонки (стек на мобилке)
 * icon — ключ из встроенного набора (ниша ремонта); нет ключа → галочка.
 */
import { nbsp } from '../lib/typography';

interface Benefit { title: string; desc?: string; icon?: string; }

interface Props {
  title: string;
  subtitle?: string;
  items: Benefit[];
  variant?: 'grid' | 'cards' | 'inline';
  eyebrow?: string;
  alt?: boolean;
  id?: string;
}

const { title, subtitle, items, variant = 'grid', eyebrow = 'Чем вы лучше других мастеров?', alt = false, id = 'benefits' } = Astro.props;

// Набор иконок под нишу ремонта (24×24 path). Расширяемый, дефолт — галочка.
const ICONS: Record<string, string> = {
  clock: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 10.4 4 2.3-1 1.7-5-2.9V6h2z',
  shield: 'M12 2 4 5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V5zm-1.2 12.9-3.3-3.3 1.4-1.4 1.9 1.9 4.3-4.3 1.4 1.4z',
  tag: 'M21.4 11.6 12.4 2.6A2 2 0 0 0 11 2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 .6 1.4l9 9a2 2 0 0 0 2.8 0l7-7a2 2 0 0 0 0-2.8zM6.5 8A1.5 1.5 0 1 1 8 6.5 1.5 1.5 0 0 1 6.5 8z',
  car: 'M18.9 6.6C18.7 6 18.1 5.5 17.4 5.5H6.6c-.7 0-1.3.5-1.5 1.1L3 12v7c0 .6.4 1 1 1h1c.6 0 1-.4 1-1v-1h12v1c0 .6.4 1 1 1h1c.6 0 1-.4 1-1v-7zM6.9 15a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm10.2 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zM5.3 11l1-3.5h11.4l1 3.5z',
  wrench: 'M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.4-.4.4-1 .1-1.4z',
  star: 'M12 2l2.9 6.3 6.8.7-5 4.6 1.4 6.7L12 17.8 5.9 20.9l1.4-6.7-5-4.6 6.8-.7z',
  check: 'M9.6 16.2 5.4 12l-1.4 1.4 5.6 5.6 12-12L20.2 5.6z',
};
const iconPath = (key?: string) => ICONS[key ?? 'check'] ?? ICONS.check;
---

<section class:list={['section', { 'section--alt': alt }]} id={id}>
  <div class="container">
    <div class="section__head" data-animate>
      <span class="eyebrow">
        <span class="eyebrow__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d={ICONS.check} /></svg>
        </span>
        {eyebrow}
      </span>
      <h2 class="section__title">{nbsp(title)}</h2>
      {subtitle && <p class="section__sub">{nbsp(subtitle)}</p>}
    </div>

    <div class:list={['benefits', `benefits--${variant}`]} data-animate>
      {items.map((b) => (
        <article class="benefit">
          <span class="benefit__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d={iconPath(b.icon)} /></svg>
          </span>
          <div class="benefit__body">
            <h3 class="benefit__title">{nbsp(b.title)}</h3>
            {b.desc && <p class="benefit__desc">{nbsp(b.desc)}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits--grid, .benefits--cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .benefits--inline { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem 2rem; }

  .benefit { display: flex; gap: 1rem; align-items: flex-start; }
  .benefit__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
  }
  .benefit__body { min-width: 0; }
  /* .benefit__title — h3, размер/вес от тега (см. tokens.css) */
  .benefit__desc { margin-top: 0.35rem; color: var(--color-text-light); font-size: 0.95rem; line-height: 1.5; }

  /* cards — карточка с рамкой/тенью, иконка сверху */
  .benefits--cards .benefit {
    flex-direction: column;
    gap: 0.9rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.6rem;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .benefits--cards .benefit:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .benefits--cards .benefit__icon { width: 56px; height: 56px; }

  @media (max-width: 900px) {
    .benefits--grid, .benefits--cards { grid-template-columns: repeat(2, 1fr); }
    .benefits--inline { grid-template-columns: 1fr; }
  }

  /* карусель на мобилке для карточных списков (grid/cards); inline стекается */
  @media (max-width: 640px) {
    .benefits--grid, .benefits--cards {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: 80%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-bottom: 0.75rem;
    }
    .benefits--grid .benefit, .benefits--cards .benefit { scroll-snap-align: center; }
  }
</style>
