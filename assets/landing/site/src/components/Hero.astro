---
import { nbsp } from '../lib/typography';

interface Rating { value: string; count: string; }
interface Bullet { icon: 'speed' | 'tool' | 'check' | 'shield'; label: string; value: string; }

// Иконки буллетов — по одному filled-path на каждую (совпадает по стилю с остальными
// инлайн-svg библиотеки: viewBox 24x24, fill currentColor).
const BULLET_ICON_D: Record<Bullet['icon'], string> = {
  speed: 'M13 2 3 14h7l-1 8 10-12h-7l1-8z',
  tool: 'M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.4-.4.4-1 .1-1.4z',
  check: 'M12 2a10 10 0 1 0 .001 20.001A10 10 0 0 0 12 2zm-1.1 14.5-4-4 1.4-1.4 2.6 2.6 5.6-5.6 1.4 1.4z',
  shield: 'M12 2 4 5v6c0 5.2 3.4 9.9 8 11 4.6-1.1 8-5.8 8-11V5l-8-3zm-1.1 14L7 12.1l1.4-1.4 2.5 2.5 5.7-5.7 1.4 1.4z',
};
const PHONE_D = 'M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1l-2.2 2.2z';
const TAG_D = 'M21.4 11.6 12.4 2.6c-.4-.4-.9-.6-1.4-.6H5c-1.1 0-2 .9-2 2v6c0 .5.2 1 .6 1.4l9 9c.8.8 2 .8 2.8 0l6-6c.8-.8.8-2.1 0-2.8zM7 8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z';

interface Props {
  title: string;             // H1 — подменяется через ?h=
  subtitle?: string;
  status?: string;           // плашка «Сейчас онлайн · принимаем заявки на сегодня»
  statusOffline?: string;    // текст плашки вне часов работы («Сейчас не работаем · заявки принимаем»);
                              // без этого prop плашка не переключает цвет/текст по времени
  bullets?: Bullet[];        // 2×2 сетка: иконка + краткое значение
  promo?: string;            // заголовок офера внизу колонки («Скидка 15% до конца дня»)
  promoNote?: string;        // статичная подпись под офером — фолбэк, если workHours не передан
  workHours?: string;        // та же константа, что уходит в Header («Пн–Вс 7:00–23:00»);
                              // время закрытия парсится из неё и живёт таймером в офере
  rating?: Rating;           // плашка рейтинга — рендерится рядом с офером
  image?: string;            // фото справа (split) или фон (image-bg)
  imageAlt?: string;
  variant?: 'default' | 'split' | 'centered' | 'image-bg';
  ctaText?: string;          // кнопка открывает модалку с формой
  phone?: string;            // вторичный CTA — позвонить
}

const {
  title,
  subtitle,
  status,
  statusOffline,
  bullets = [],
  promo,
  promoNote,
  workHours,
  rating,
  image,
  imageAlt = '',
  variant = 'default',
  ctaText = 'Оставить заявку',
  phone,
} = Astro.props;

const telHref = phone ? 'tel:' + phone.replace(/[^\d+]/g, '') : null;

// Первое и последнее HH:MM в строке часов работы — открытие/закрытие
// («Пн–Вс 7:00–23:00» → «7:00» и «23:00»). День недели не учитываем (упрощение —
// подходит, пока в библиотеке нет часов работы с разным графиком по дням).
const workTimeMatch = workHours?.match(/\d{1,2}:\d{2}/g);
const openTime = workTimeMatch?.[0] ?? null;
const closeTime = workTimeMatch?.[workTimeMatch.length - 1] ?? null;
---

<section class:list={['hero', `hero--${variant}`]} id="top-hero">
  {variant === 'image-bg' && image && (
    <img class="hero__bg" src={image} alt="" aria-hidden="true" fetchpriority="high" />
  )}
  <div class="container hero__inner">
    <div class="hero__content" data-animate>
      {status && (
        <span class="hero__status" data-status-widget data-open-time={openTime} data-close-time={closeTime}>
          <span class="hero__status-dot" aria-hidden="true">
            <span class="hero__status-ping" aria-hidden="true"></span>
          </span>
          <span data-status-online>{nbsp(status)}</span>
          {statusOffline && <span data-status-offline hidden>{nbsp(statusOffline)}</span>}
        </span>
      )}
      <h1 class="hero__title">{nbsp(title)}</h1>
      {subtitle && <p class="hero__subtitle">{nbsp(subtitle)}</p>}

      {bullets.length > 0 && (
        <div class="hero__bullets">
          {bullets.map((b) => (
            <div class="hero__bullet">
              <svg class="hero__bullet-icon" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d={BULLET_ICON_D[b.icon]} /></svg>
              <span>{nbsp(b.label)} <strong>{nbsp(b.value)}</strong></span>
            </div>
          ))}
        </div>
      )}

      <div class="hero__cta">
        <button class="btn btn--primary" type="button" data-open-modal>{ctaText}</button>
        {telHref && (
          <a class="btn btn--ghost hero__call" href={telHref}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={PHONE_D} /></svg>
            Позвонить сейчас
          </a>
        )}
      </div>

      {(promo || rating) && (
        <div class="hero__bottom">
          {promo && (
            <div class="hero__offer">
              <span class="hero__offer-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d={TAG_D} /></svg>
              </span>
              <span class="hero__offer-text">
                <strong>{nbsp(promo)}</strong>
                {closeTime ? (
                  <span class="hero__offer-note" data-countdown data-close-time={closeTime}>
                    Осталось <span data-countdown-value>{closeTime}</span>
                  </span>
                ) : promoNote ? (
                  <span class="hero__offer-note">{nbsp(promoNote)}</span>
                ) : null}
              </span>
            </div>
          )}

          {rating && (
            <div class="hero__rating">
              <span class="hero__rating-badge" aria-hidden="true">Я</span>
              <div class="hero__rating-body">
                <div class="hero__rating-top">
                  <span class="hero__stars" aria-hidden="true">★★★★★</span>
                  <strong>{rating.value}</strong>
                </div>
                <span class="hero__rating-count">{nbsp(rating.count)}</span>
              </div>
            </div>
          )}
        </div>
      )}
    </div>

    {variant === 'split' && (
      <div class="hero__media" data-animate>
        {image ? (
          <img class="hero__media-img" src={image} alt={imageAlt} width="1200" height="896" fetchpriority="high" />
        ) : (
          <div class="hero__media-ph" role="img" aria-label="Место для фото">
            <svg viewBox="0 0 24 24" width="72" height="72" fill="currentColor" aria-hidden="true"><path d="M19 8h-1V3H6v5H5a3 3 0 0 0-3 3v6h4v3h12v-3h4v-6a3 3 0 0 0-3-3zM8 5h8v3H8V5zm8 14H8v-4h8v4zm3-5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/></svg>
          </div>
        )}
      </div>
    )}
  </div>
</section>

<script is:inline>
  (function () {
    function pad(n) { return String(n).padStart(2, '0'); }
    function startCountdown(el) {
      var close = el.getAttribute('data-close-time'); // «23:00»
      var valueEl = el.querySelector('[data-countdown-value]');
      if (!close || !valueEl) return;
      var parts = close.split(':').map(Number);
      var hh = parts[0], mm = parts[1];
      function nextClose() {
        var t = new Date();
        t.setHours(hh, mm, 0, 0);
        if (t.getTime() <= Date.now()) t.setDate(t.getDate() + 1);
        return t;
      }
      function update() {
        var diff = Math.max(0, nextClose().getTime() - Date.now());
        var h = Math.floor(diff / 3600000);
        var m = Math.floor((diff % 3600000) / 60000);
        var s = Math.floor((diff % 60000) / 1000);
        valueEl.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
      }
      update();
      setInterval(update, 1000);
    }

    function toMinutes(hhmm) {
      var p = hhmm.split(':').map(Number);
      return p[0] * 60 + p[1];
    }
    function startStatusWidget(el) {
      var openTime = el.getAttribute('data-open-time');
      var closeTime = el.getAttribute('data-close-time');
      var offlineEl = el.querySelector('[data-status-offline]');
      var onlineEl = el.querySelector('[data-status-online]');
      // Без пары «открытие/закрытие» или без офлайн-текста переключать нечем и не на что.
      if (!openTime || !closeTime || !offlineEl) return;
      var openMin = toMinutes(openTime), closeMin = toMinutes(closeTime);
      function isOpenNow() {
        var nowMin = new Date().getHours() * 60 + new Date().getMinutes();
        if (openMin === closeMin) return true; // круглосуточно
        if (openMin < closeMin) return nowMin >= openMin && nowMin < closeMin;
        return nowMin >= openMin || nowMin < closeMin; // ночной график через полночь
      }
      function apply() {
        var open = isOpenNow();
        el.classList.toggle('hero__status--offline', !open);
        if (onlineEl) onlineEl.hidden = !open;
        offlineEl.hidden = open;
      }
      apply();
      setInterval(apply, 60000);
    }

    document.querySelectorAll('[data-countdown]').forEach(startCountdown);
    document.querySelectorAll('[data-status-widget]').forEach(startStatusWidget);
  })();
</script>

<style>
  .hero { position: relative; overflow: hidden; background:
    radial-gradient(1200px 600px at 85% -10%, color-mix(in srgb, var(--color-primary) 12%, transparent), transparent 60%),
    var(--color-bg);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5.5rem);
  }
  .hero__content { max-width: 640px; }
  /* Статус-плашка — тише CTA: бледная заливка + акцентный текст, не сплошной цвет.
     Вне часов работы (--offline, ставит скрипт по data-open/close-time) — гаснет до нейтрального. */
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent-dark);
    font-weight: 600;
    font-size: 0.78rem;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.1rem;
    transition: background var(--transition), color var(--transition);
  }
  .hero__status--offline {
    background: color-mix(in srgb, var(--color-text-light) 14%, transparent);
    color: var(--color-text-light);
  }
  .hero__status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .hero__status--offline .hero__status-dot { background: var(--color-text-light); }
  /* «Пульс» — расширяющееся кольцо от точки, сигнализирует «сейчас в сети» */
  .hero__status-ping {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-accent);
    animation: hero-status-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .hero__status--offline .hero__status-ping { display: none; }
  @keyframes hero-status-ping {
    0% { transform: scale(1); opacity: 0.55; }
    100% { transform: scale(2.8); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__status-ping { animation: none; }
  }
  /* .hero__title — h1, размер/вес/трекинг от тега (см. tokens.css) */
  .hero__subtitle { margin-top: 1rem; font-size: 1.15rem; color: var(--color-text-light); max-width: 46ch; }

  /* Буллеты — сетка 2×2: иконка + значение, а не список */
  .hero__bullets { margin-top: 1.6rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.85rem 1.5rem; max-width: 460px; }
  .hero__bullet { display: flex; align-items: center; gap: 0.6rem; font-size: 0.95rem; color: var(--color-text-light); }
  .hero__bullet-icon { color: var(--color-primary); flex: none; }
  .hero__bullet strong { color: var(--color-text); font-weight: 700; }

  .hero__cta { margin-top: clamp(2rem, 1.4rem + 2vw, 2.75rem); display: flex; flex-wrap: wrap; gap: 0.85rem; }

  /* Ряд «офер + рейтинг» — рейтинг стоит напротив блока со скидкой, не под ним.
     nowrap + сжатие офера держат оба элемента в одной строке даже в узкой колонке
     (variant split), полностью в столбец уходят только на маленьком мобильном экране. */
  .hero__bottom {
    margin-top: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 1.1rem;
  }

  /* Офер — пунктирная карточка, тише промо-плашки; сжимается первым в тесной колонке */
  .hero__offer {
    flex-shrink: 1;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    border: 1.5px dashed color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }
  .hero__offer-icon {
    flex: none;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    color: var(--color-accent-dark);
  }
  .hero__offer-text { display: flex; flex-direction: column; min-width: 0; font-size: 0.95rem; }
  .hero__offer-note { margin-top: 0.15rem; font-size: 0.85rem; color: var(--color-text-light); }
  .hero__offer-note [data-countdown-value] { font-weight: 700; color: var(--color-accent-dark); font-variant-numeric: tabular-nums; }

  /* Компактный рейтинг — «★★★★★ 4.9» и подпись отзывов в две строки, а не в одну широкую.
     Кружок «Я» слева — источник отзывов (Яндекс), фирменный красный. */
  .hero__rating { flex: none; display: flex; align-items: center; gap: 0.65rem; font-size: 0.9rem; white-space: nowrap; }
  .hero__rating-badge {
    flex: none;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fc3f1d;
    color: #fff;
    font-weight: 800;
    font-size: 1.2rem;
  }
  .hero__rating-body { display: flex; flex-direction: column; gap: 0.05rem; line-height: 1.2; }
  .hero__rating-top { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.95rem; }
  .hero__rating-count { color: var(--color-text-light); }
  .hero__stars { color: #f5b301; letter-spacing: 1px; font-size: 0.9em; }

  /* variant: split — контент слева, изображение справа (сбалансированные колонки) */
  .hero--split .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: center;
  }
  .hero--split .hero__content { max-width: 560px; }
  .hero__media { position: relative; }
  /* декоративный акцент за картинкой — держит баланс с акцентным CTA */
  .hero__media::before {
    content: '';
    position: absolute;
    inset: auto -8% -8% auto;
    width: 62%;
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-accent-warm) 35%, transparent);
    z-index: 0;
  }
  .hero__media-img,
  .hero__media-ph {
    position: relative;
    z-index: 1;
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .hero__media-img { object-fit: cover; aspect-ratio: 36 / 31; }
  .hero__media-ph {
    aspect-ratio: 36 / 31;
    display: flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--color-primary) 45%, var(--color-bg));
    background:
      linear-gradient(135deg,
        color-mix(in srgb, var(--color-primary) 10%, var(--color-bg)),
        color-mix(in srgb, var(--color-accent) 10%, var(--color-bg)));
    border: 1px solid var(--color-border);
  }

  /* variant: centered */
  .hero--centered .hero__content { max-width: 720px; margin-inline: auto; text-align: center; }
  .hero--centered .hero__subtitle { margin-inline: auto; }
  .hero--centered .hero__status { margin-inline: auto; }
  .hero--centered .hero__bullets { margin-inline: auto; text-align: left; }
  .hero--centered .hero__cta { justify-content: center; }
  .hero--centered .hero__bottom { justify-content: center; text-align: left; }

  /* variant: image-bg — фон-фото + оверлей, светлый текст */
  .hero--image-bg .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero--image-bg::after { content: ''; position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--color-overlay) 86%, transparent) 0%,
      color-mix(in srgb, var(--color-overlay) 55%, transparent) 55%,
      color-mix(in srgb, var(--color-overlay) 25%, transparent) 100%); }
  .hero--image-bg .hero__content { color: var(--color-on-overlay); }
  .hero--image-bg .hero__title { color: inherit; }
  .hero--image-bg .hero__subtitle { color: color-mix(in srgb, var(--color-on-overlay) 85%, transparent); }
  .hero--image-bg .hero__bullet svg { color: var(--color-accent); }
  .hero--image-bg .hero__call { color: var(--color-on-overlay); border-color: color-mix(in srgb, var(--color-on-overlay) 40%, transparent); }

  @media (max-width: 900px) {
    .hero--split .hero__inner { grid-template-columns: 1fr; gap: 2rem; }
    .hero--split .hero__content { max-width: none; }
    .hero__media { order: 2; max-width: 520px; }
  }
  @media (max-width: 560px) {
    .hero__cta { flex-direction: column; }
    .hero__cta .btn { width: 100%; }
    .hero__bottom { flex-direction: column; align-items: stretch; }
    .hero__offer { flex-shrink: 0; width: 100%; }
    /* Рейтинг важен для решения — выделяем его воздухом и центрируем, а не жмём к офферу.
       Кружок «Я» переезжает наверх — как бейдж источника отзывов над цифрой, а не иконка сбоку. */
    .hero__rating {
      align-self: center;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 0.9rem;
      padding-block: 0.5rem;
    }
    .hero__rating-body { align-items: center; text-align: center; }
    .hero__rating-top { justify-content: center; }
  }
</style>
