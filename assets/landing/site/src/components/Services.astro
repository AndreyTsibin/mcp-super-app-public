---
/*
 * «Услуги / направления» — перечень того, с чем работает компания (поле маркетолога
 * «Перечень услуг»). Скелет заморожен, LLM даёт items/brands/variant.
 *   cards — карточки типов с иконкой и описанием (→ карусель на мобилке)
 *   tiles — компактные плитки «иконка + название» (грид, 2 колонки на мобилке)
 *   list  — чек-список в 2 колонки (стек на мобилке)
 *   split — фото слева (30%) + компактный список в один столбец справа (70%);
 *           на мобилке фото сверху, список стекается в одну колонку
 * brands — опциональная лента брендов-чипов под списком (любой variant).
 */
import Img from './Img.astro';
import { nbsp } from '../lib/typography';

interface ServiceItem { title: string; desc?: string; icon?: string; }

interface Props {
  title: string;
  subtitle?: string;
  items: ServiceItem[];
  brands?: string[];
  variant?: 'cards' | 'tiles' | 'list' | 'split';
  image?: ImageMetadata | string;
  imageAlt?: string;
  eyebrow?: string;
  /** Текст кнопки в карточке (variant=split) — открывает модалку заявки. */
  itemCtaText?: string;
  /** Подпись перед лентой брендов. */
  brandsLabel?: string;
  alt?: boolean;
  id?: string;
}

const {
  title, subtitle, items, brands = [], variant = 'cards', image, imageAlt = '',
  eyebrow, itemCtaText = 'Оставить заявку →', brandsLabel = 'Работаем с брендами:',
  alt = false, id = 'services',
} = Astro.props;

// Нейтральный набор иконок (24×24 path) — под любую нишу. Ключ не найден → галочка.
// Нужен свой символ — добавь ключ, набор расширяемый.
const ICONS: Record<string, string> = {
  check: 'M12 2a10 10 0 1 0 .001 20.001A10 10 0 0 0 12 2zm-1.1 14.5-4-4 1.4-1.4 2.6 2.6 5.6-5.6 1.4 1.4z',
  grid: 'M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z',
  layers: 'M12 2 2 7l10 5 10-5zM2 12l10 5 10-5-2-1-8 4-8-4zM2 17l10 5 10-5-2-1-8 4-8-4z',
  doc: 'M6 2h9l5 5v15H6zm8 8H9v2h5zm2 4H9v2h7z',
  monitor: 'M3 4h18a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-7v2h3v2H7v-2h3v-2H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z',
  laptop: 'M5 4h14a1 1 0 0 1 1 1v9H4V5a1 1 0 0 1 1-1zM2 16h20l-2 3H4z',
  chip: 'M8 8h8v8H8zM7 4h2v3H7zm4 0h2v3h-2zm4 0h2v3h-2zM7 17h2v3H7zm4 0h2v3h-2zm4 0h2v3h-2zM4 7h3v2H4zm0 4h3v2H4zm0 4h3v2H4zm13-8h3v2h-3zm0 4h3v2h-3zm0 4h3v2h-3z',
  tag: 'M21.4 11.6 12.4 2.6A2 2 0 0 0 11 2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 .6 1.4l9 9a2 2 0 0 0 2.8 0l7-7a2 2 0 0 0 0-2.8zM6.5 8A1.5 1.5 0 1 1 8 6.5 1.5 1.5 0 0 1 6.5 8z',
  wrench: 'M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.4-.4.4-1 .1-1.4z',
};
const iconPath = (key?: string) => ICONS[key ?? 'check'] ?? ICONS.check;
---

<section class:list={['section', { 'section--alt': alt }]} id={id}>
  <div class="container">
    <div class="section__head" data-animate>
      {eyebrow && (
        <span class="eyebrow">
          <span class="eyebrow__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d={iconPath('grid')} /></svg>
          </span>
          {eyebrow}
        </span>
      )}
      <h2 class="section__title">{nbsp(title)}</h2>
      {subtitle && <p class="section__sub">{nbsp(subtitle)}</p>}
    </div>

    {variant === 'split' ? (
      <div class="services-split" data-animate>
        <div class="services-split__media">
          {image ? (
            <Img class="services-split__img" src={image} alt={imageAlt} width={900} height={1205} loading="lazy" />
          ) : (
            <div class="services-split__ph" role="img" aria-label="Место для фото">
              <svg viewBox="0 0 24 24" width="56" height="56" fill="currentColor" aria-hidden="true"><path d="M19 8h-1V3H6v5H5a3 3 0 0 0-3 3v6h4v3h12v-3h4v-6a3 3 0 0 0-3-3zM8 5h8v3H8V5zm8 14H8v-4h8v4zm3-5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/></svg>
            </div>
          )}
        </div>
        <div class="services services--split">
          {items.map((it) => (
            <article class="service">
              <span class="service__icon service__icon--lg" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d={iconPath(it.icon)} /></svg>
              </span>
              <div class="service__body">
                <h3 class="service__title">{nbsp(it.title)}</h3>
                {it.desc && <p class="service__desc">{nbsp(it.desc)}</p>}
                <button class="service__cta" type="button" data-open-modal>{itemCtaText}</button>
              </div>
            </article>
          ))}
        </div>
      </div>
    ) : (
      <div class:list={['services', `services--${variant}`]} data-animate>
        {items.map((it) => (
          <article class="service">
            <span class="service__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d={iconPath(it.icon)} /></svg>
            </span>
            <div class="service__body">
              <h3 class="service__title">{nbsp(it.title)}</h3>
              {it.desc && variant !== 'tiles' && <p class="service__desc">{nbsp(it.desc)}</p>}
            </div>
          </article>
        ))}
      </div>
    )}

    {brands.length > 0 && (
      <div class="brands" data-animate>
        <span class="brands__label">{brandsLabel}</span>
        <ul class="brands__list">
          {brands.map((b) => <li class="brands__chip">{b}</li>)}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  /* ---------- variant: cards ---------- */
  .services--cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .services--cards .service {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .services--cards .service:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

  /* ---------- variant: tiles ---------- */
  .services--tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 1rem; }
  .services--tiles .service {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.7rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.4rem 1rem;
    transition: transform var(--transition), border-color var(--transition);
  }
  .services--tiles .service:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border)); }
  .services--tiles .service__title { font-size: 0.95rem; }

  /* ---------- variant: list ---------- */
  .services--list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem 2rem; }
  .services--list .service { display: flex; gap: 0.9rem; align-items: flex-start; }
  .services--list .service__icon { width: 44px; height: 44px; }

  /* ---------- variant: split (фото + компактный список в 1 столбец) ---------- */
  .services-split { display: grid; grid-template-columns: 2fr 3fr; gap: clamp(1.5rem, 1rem + 2vw, 2.5rem); align-items: stretch; }
  .services-split__media { position: relative; }
  .services-split__img,
  .services-split__ph {
    width: 100%;
    height: 100%;
    min-height: 360px;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    object-fit: cover;
  }
  .services-split__ph {
    display: flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--color-primary) 45%, var(--color-bg));
    background:
      linear-gradient(135deg,
        color-mix(in srgb, var(--color-primary) 10%, var(--color-bg)),
        color-mix(in srgb, var(--color-accent) 10%, var(--color-bg)));
    border: 1px solid var(--color-border);
  }
  .services--split { display: flex; flex-direction: column; gap: 0.75rem; }
  .services--split .service {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.25rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .services--split .service__icon.service__icon--lg { width: 60px; height: 60px; }
  .services--split .service__desc { margin-top: 0.2rem; }
  .service__cta {
    display: inline-flex;
    align-items: center;
    margin-top: 0.45rem;
    padding: 0;
    background: none;
    border: none;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
  }
  .service__cta:hover { text-decoration: underline; }

  .service__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    flex: none;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
  }
  .service__body { min-width: 0; flex: 1 1 auto; }
  /* .service__title — h3, размер/вес от тега (см. tokens.css) */
  .service__desc { margin-top: 0.35rem; color: var(--color-text-light); font-size: 0.92rem; line-height: 1.5; }

  /* ---------- бренды-чипы ---------- */
  .brands { margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem); display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.75rem 1rem; }
  .brands__label { font-size: 0.88rem; font-weight: 600; color: var(--color-text-light); flex: none; }
  .brands__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .brands__chip {
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-light);
  }

  /* ---------- адаптив ---------- */
  @media (max-width: 900px) {
    .services--cards { grid-template-columns: repeat(2, 1fr); }
    .services--list { grid-template-columns: 1fr; }
    .services-split { grid-template-columns: 1fr; }
    .services-split__img, .services-split__ph { min-height: 260px; max-height: 340px; }
  }

  /* карусель на мобилке для карточек; tiles → 2 колонки, list стекается */
  @media (max-width: 640px) {
    .services--cards {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: 80%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-bottom: 0.75rem;
    }
    .services--cards .service { scroll-snap-align: center; }
    .services--tiles { grid-template-columns: repeat(2, 1fr); }
  }
</style>
