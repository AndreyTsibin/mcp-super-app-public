---
/*
 * «О компании» (Шаблон 3). Скелет заморожен, LLM даёт paragraphs/stats/variant.
 *   split    — текст слева, фото справа (нет фото → placeholder), цифры под текстом
 *   stats    — текст + крупная сетка цифр снизу
 *   centered — всё по центру, цифры в ряд
 */
import { nbsp } from '../lib/typography';

interface Stat { value: string; label: string; }

interface Props {
  title: string;
  subtitle?: string;
  paragraphs: string[];
  stats?: Stat[];
  image?: string;
  imageAlt?: string;
  variant?: 'split' | 'stats' | 'centered';
  eyebrow?: string;
  alt?: boolean;
  id?: string;
}

const {
  title,
  subtitle,
  paragraphs,
  stats = [],
  image,
  imageAlt = '',
  variant = 'stats',
  eyebrow = 'Не окажетесь ли завтра закрыты?',
  alt = false,
  id = 'about',
} = Astro.props;

const BUILDING = 'M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16h4v2H2v-2zm4-14h2v2H8zm4 0h2v2h-2zM8 11h2v2H8zm4 0h2v2h-2zM8 15h2v2H8zm4 0h2v2h-2z';
---

<section class:list={['section', { 'section--alt': alt }, `about-section--${variant}`]} id={id}>
  <div class="container">
    <div class:list={['about', `about--${variant}`]}>
      <div class="about__content" data-animate>
        <div class="about__head">
          <span class="eyebrow">
            <span class="eyebrow__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d={BUILDING} /></svg>
            </span>
            {eyebrow}
          </span>
          <h2 class="section__title">{nbsp(title)}</h2>
          {subtitle && <p class="section__sub">{nbsp(subtitle)}</p>}
        </div>
        <div class="about__text">
          {paragraphs.map((p) => <p>{nbsp(p)}</p>)}
        </div>
      </div>

      {variant === 'split' && (
        <div class="about__media" data-animate>
          {image
            ? <img src={image} alt={imageAlt} loading="lazy" />
            : <span class="about__placeholder" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="64" height="64" fill="currentColor"><path d={BUILDING} /></svg>
              </span>}
        </div>
      )}

      {stats.length > 0 && (
        <dl class="about__stats" data-animate>
          {stats.map((s) => (
            <div class="stat">
              <dd class="stat__value">{nbsp(s.value)}</dd>
              <dt class="stat__label">{nbsp(s.label)}</dt>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</section>

<style>
  .about__head { margin-bottom: 1.5rem; }
  .about__text { display: flex; flex-direction: column; gap: 1rem; color: var(--color-text); max-width: 64ch; }

  /* ---------- variant: split ---------- */
  .about--split {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 1rem + 3vw, 3.5rem);
    align-items: start;
  }
  .about--split .about__stats { grid-column: 1; margin-top: 2rem; }
  .about__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-primary) 8%, var(--color-bg-section));
    box-shadow: var(--shadow-md);
  }
  .about__media img { width: 100%; height: 100%; object-fit: cover; }
  .about__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  /* ---------- variant: stats / centered ---------- */
  .about--stats .about__stats { margin-top: clamp(2rem, 1.5rem + 2vw, 3rem); }
  .about--centered { text-align: center; }
  .about--centered .about__head { max-width: 640px; margin-inline: auto; }
  .about--centered .about__text { margin-inline: auto; }
  .about--centered .about__stats { margin-top: clamp(2rem, 1.5rem + 2vw, 3rem); }

  /* ---------- цифры ---------- */
  .about__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-block: 0;
    padding: 0;
  }
  .stat {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .about--centered .stat { align-items: center; text-align: center; }
  .stat__value {
    margin: 0;
    font-size: clamp(1.6rem, 1.3rem + 1.5vw, 2.2rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: var(--lh-tight);
  }
  .stat__label { font-size: 0.88rem; color: var(--color-text-light); }

  /* ---------- адаптив ---------- */
  @media (max-width: 900px) {
    .about--split { grid-template-columns: 1fr; }
    .about--split .about__media { order: -1; }  /* фото над текстом на планшете/мобилке */
    .about__stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
