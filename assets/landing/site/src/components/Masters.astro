---
/*
 * «Мастера» — команда инженеров (Шаблон 2). Скелет заморожен, LLM даёт items/variant.
 *   cards      — фото сверху, карточки в ряд (→ карусель на мобилке — стандарт заказчика)
 *   horizontal — фото слева, 2 колонки (→ карусель на мобилке)
 *   compact    — круглые аватары, плотный ряд (→ карусель на мобилке)
 * Нет фото → placeholder-силуэт (реальное фото придёт из image-пайплайна).
 */
import { nbsp } from '../lib/typography';

interface Master {
  name: string;
  role?: string;             // специализация: «лазерные принтеры и МФУ»
  experience?: string;       // «стаж 12 лет»
  note?: string;             // доп. факт: «более 2 000 ремонтов»
  photo?: string;
  photoAlt?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  items: Master[];
  variant?: 'cards' | 'horizontal' | 'compact';
  eyebrow?: string;
  alt?: boolean;
  id?: string;
}

const { title, subtitle, items, variant = 'cards', eyebrow = 'Кто ко мне приедет?', alt = false, id = 'masters' } = Astro.props;

const PERSON = 'M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-5 0-9 2.5-9 6v2h18v-2c0-3.5-4-6-9-6z';
---

<section class:list={['section', { 'section--alt': alt }]} id={id}>
  <div class="container">
    <div class="section__head" data-animate>
      <span class="eyebrow">
        <span class="eyebrow__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d={PERSON} /></svg>
        </span>
        {eyebrow}
      </span>
      <h2 class="section__title">{nbsp(title)}</h2>
      {subtitle && <p class="section__sub">{nbsp(subtitle)}</p>}
    </div>

    <div class:list={['masters', `masters--${variant}`]} data-animate>
      {items.map((m) => (
        <article class="master">
          <div class="master__photo">
            {m.photo
              ? <img src={m.photo} alt={m.photoAlt ?? m.name} loading="lazy" />
              : <span class="master__placeholder" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor"><path d={PERSON} /></svg>
                </span>}
          </div>
          <div class="master__body">
            <h3 class="master__name">{nbsp(m.name)}</h3>
            {m.role && <p class="master__role">{nbsp(m.role)}</p>}
            {m.experience && <span class="master__exp">{nbsp(m.experience)}</span>}
            {m.note && <p class="master__note">{nbsp(m.note)}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ---------- variant: cards ---------- */
  .masters--cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .masters--cards .master {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .masters--cards .master:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .masters--cards .master__photo { aspect-ratio: 1 / 1; }
  .masters--cards .master__body { padding: 1.1rem 1.25rem 1.35rem; }

  /* ---------- variant: horizontal ---------- */
  .masters--horizontal { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .masters--horizontal .master {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }
  .masters--horizontal .master__photo {
    width: 96px;
    aspect-ratio: 1 / 1;
    flex: none;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  /* ---------- variant: compact ---------- */
  .masters--compact { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .masters--compact .master { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .masters--compact .master__photo {
    width: 110px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 0.9rem;
  }
  .masters--compact .master__exp { align-self: center; }

  /* ---------- общее ---------- */
  .master__photo { position: relative; background: color-mix(in srgb, var(--color-accent-warm) 16%, var(--color-bg-section)); }
  .master__photo img { width: 100%; height: 100%; object-fit: cover; }
  .master__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--color-accent-warm-dark) 55%, transparent);
  }
  .master__body { min-width: 0; flex: 1 1 auto; display: flex; flex-direction: column; gap: 0.3rem; align-items: flex-start; }
  /* .master__name — h3, размер/вес от тега (см. tokens.css) */
  .master__role { color: var(--color-text-light); font-size: 0.9rem; line-height: 1.45; }
  .master__exp {
    margin-top: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--color-primary);
    white-space: nowrap;
  }
  .master__note { font-size: 0.85rem; color: var(--color-text-light); }
  .masters--compact .master__body { align-items: center; }

  /* ---------- адаптив ---------- */
  @media (max-width: 900px) {
    .masters--cards, .masters--compact { grid-template-columns: repeat(2, 1fr); }
    .masters--horizontal { grid-template-columns: 1fr; }
  }

  /* КАРУСЕЛЬ НА МОБИЛКЕ — стандарт заказчика (отзывы/мастера/сертификаты) */
  @media (max-width: 768px) {
    .masters--cards, .masters--compact, .masters--horizontal {
      display: grid;
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: 78%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-bottom: 0.75rem;
    }
    .master { scroll-snap-align: center; }
    .masters--horizontal .master { flex-direction: column; }
    .masters--horizontal .master__photo { width: 100%; }
  }
</style>
