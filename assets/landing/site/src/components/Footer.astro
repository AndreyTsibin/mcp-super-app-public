---
/*
 * Подвал. Реквизиты (ИНН/ОГРНИП/ИП ФИО) — обязательное поле маркетолога (юр. требование).
 * Тёмный фон на токенах (--color-text как подложка, --color-bg как текст — WCAG ок).
 *   columns  — многоколоночный (бренд · навигация · контакты · реквизиты)
 *   centered — всё по центру в столбик (короткие лендинги)
 *   compact  — одна строка: бренд слева, реквизиты+телефон справа
 */
import { nbsp } from '../lib/typography';

interface NavItem { label: string; href: string; }
interface Requisites { inn?: string; ogrnip?: string; entity?: string; }

interface Props {
  brand: string;
  phone: string;
  workHours?: string;
  address?: string;
  nav?: NavItem[];
  requisites?: Requisites;
  policyHref?: string;
  tagline?: string;
  variant?: 'columns' | 'centered' | 'compact';
  logoIcon?: boolean;
}

const {
  brand, phone, workHours, address, nav = [], requisites,
  policyHref = '/privacy', tagline, variant = 'columns', logoIcon = false,
} = Astro.props;

const telHref = 'tel:' + phone.replace(/[^\d+]/g, '');
const navItems = nav.slice(0, 5);
---

<footer class:list={['footer', `footer--${variant}`]}>
  <div class="container footer__inner">
    <div class="footer__brand-col">
      <a class="footer__logo" href="/" aria-label={`${brand} — на главную`}>
        {logoIcon && (
          <span class="footer__logo-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.4-.4.4-1 .1-1.4z"/></svg>
          </span>
        )}
        <span class="footer__logo-text">{brand}</span>
      </a>
      {tagline && <p class="footer__tagline">{nbsp(tagline)}</p>}
    </div>

    {navItems.length > 0 && (
      <nav class="footer__nav" aria-label="Разделы (подвал)">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    )}

    <div class="footer__contacts">
      <a class="footer__phone" href={telHref}>{phone}</a>
      {workHours && <span class="footer__muted">{nbsp(workHours)}</span>}
      {address && <span class="footer__muted">{nbsp(address)}</span>}
    </div>

    {requisites && (requisites.entity || requisites.inn || requisites.ogrnip) && (
      <div class="footer__requisites">
        {requisites.entity && <span class="footer__muted">{nbsp(requisites.entity)}</span>}
        {requisites.inn && <span class="footer__muted">ИНН {requisites.inn}</span>}
        {requisites.ogrnip && <span class="footer__muted">ОГРНИП {requisites.ogrnip}</span>}
      </div>
    )}
  </div>

  <div class="container footer__bottom">
    <span class="footer__muted">© {brand}. Все права защищены.</span>
    <a class="footer__policy" href={policyHref}>Политика конфиденциальности</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-text);            /* тёмная подложка на токене */
    color: var(--color-bg);
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    align-items: start;
  }
  .footer__logo { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: 1.2rem; }
  .footer__logo-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; flex: none;
    border-radius: var(--radius-sm);
    background: var(--color-accent); color: var(--color-on-accent);
  }
  .footer__logo-text { color: var(--color-bg); }
  .footer__tagline { margin-top: 0.75rem; color: color-mix(in srgb, var(--color-bg) 70%, transparent); font-size: 0.9rem; line-height: 1.5; max-width: 30ch; }

  .footer__nav { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer__nav a { color: color-mix(in srgb, var(--color-bg) 78%, transparent); font-size: 0.92rem; transition: color var(--transition); }
  .footer__nav a:hover { color: var(--color-bg); }

  .footer__contacts { display: flex; flex-direction: column; gap: 0.4rem; }
  .footer__phone { font-weight: 800; font-size: 1.2rem; color: var(--color-bg); white-space: nowrap; }
  .footer__requisites { display: flex; flex-direction: column; gap: 0.4rem; }
  .footer__muted { color: color-mix(in srgb, var(--color-bg) 62%, transparent); font-size: 0.85rem; line-height: 1.5; }

  .footer__bottom {
    margin-top: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-bg) 15%, transparent);
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: center; justify-content: space-between;
  }
  .footer__policy { color: color-mix(in srgb, var(--color-bg) 78%, transparent); font-size: 0.85rem; text-decoration: underline; }
  .footer__policy:hover { color: var(--color-bg); }

  /* centered — короткие лендинги */
  .footer--centered .footer__inner { grid-template-columns: 1fr; justify-items: center; text-align: center; }
  .footer--centered .footer__nav { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 0.6rem 1.5rem; }
  .footer--centered .footer__tagline { max-width: none; }
  .footer--centered .footer__contacts,
  .footer--centered .footer__requisites { align-items: center; }

  /* compact — бренд слева, всё остальное справа одной строкой */
  .footer--compact .footer__inner { grid-template-columns: auto 1fr; align-items: center; }
  .footer--compact .footer__nav { display: none; }
  .footer--compact .footer__contacts { grid-column: 2; align-items: flex-end; }
  .footer--compact .footer__requisites { grid-column: 2; align-items: flex-end; text-align: right; }

  @media (max-width: 860px) {
    .footer__inner { grid-template-columns: 1fr 1fr; }
    .footer--compact .footer__inner { grid-template-columns: 1fr; }
    .footer--compact .footer__contacts,
    .footer--compact .footer__requisites { grid-column: auto; align-items: flex-start; text-align: left; }
  }
  @media (max-width: 520px) {
    .footer__inner { grid-template-columns: 1fr; }
    .footer__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
