---
/*
 * Слот шаблона «Неисправности / Цены / Пакеты» — знак «/» в брифе = выбор контента
 * через variant. Скелет секции заморожен; LLM выбирает variant и заполняет данные.
 *   issues   — карточки типовых поломок (грид → карусель на мобилке), клик открывает модалку
 *              issuesLayout=split — список в 1 колонку слева + фото справа (40%)
 *   prices   — прайс-таблица «услуга … цена» (стек на мобилке)
 *   packages — тарифные пакеты (2–3 карты, одна featured; карусель на мобилке)
 */
import Img from './Img.astro';
import { nbsp } from '../lib/typography';

interface Issue { title: string; desc?: string; price?: string; icon?: string; }
interface PriceRow { service: string; price: string; note?: string; }
interface Package {
  name: string;
  price: string;
  period?: string;          // «/ мес», «/ год»
  note?: string;
  features: string[];
  featured?: boolean;       // выделенный тариф (максимум один)
  ctaText?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  variant: 'issues' | 'prices' | 'packages';
  issues?: Issue[];
  prices?: PriceRow[];
  packages?: Package[];
  ctaText?: string;         // текст кнопки под прайсом (variant=prices)
  eyebrow?: string;
  alt?: boolean;            // фон section--alt для чередования при композиции
  id?: string;
  issuesLayout?: 'grid' | 'split';   // только для variant=issues
  image?: ImageMetadata | string;    // фото справа при issuesLayout=split
  imageAlt?: string;
  note?: string;                     // дисклеймер под списком при issuesLayout=split («цены от»)
}

const {
  title,
  subtitle,
  variant,
  issues = [],
  prices = [],
  packages = [],
  ctaText = 'Узнать цену',
  eyebrow,
  alt = false,
  id = 'issues',
  issuesLayout = 'grid',
  image,
  imageAlt = '',
  note,
} = Astro.props;

// Иконка eyebrow зависит от variant — текст пишет автор страницы (нет пропа → нет eyebrow).
const ISSUE_D = 'M21.7 18.6 15 11.9a5.5 5.5 0 0 0-6.9-6.9L11 7.9 8 10.9 5.1 8A5.5 5.5 0 0 0 12 14.9l6.7 6.7c.4.4 1 .4 1.4 0l1.6-1.6c.4-.4.4-1 0-1.4z';
const TAG_D = 'M21.4 11.6 12.4 2.6A2 2 0 0 0 11 2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 .6 1.4l9 9a2 2 0 0 0 2.8 0l7-7a2 2 0 0 0 0-2.8zM6.5 8A1.5 1.5 0 1 1 8 6.5 1.5 1.5 0 0 1 6.5 8z';
const BOX_D = 'M4 4h16v4H4zM5 9h14v11H5zm4 3h6v2H9z';
const ICON_BY_VARIANT: Record<typeof variant, string> = { issues: ISSUE_D, prices: TAG_D, packages: BOX_D };
const eyebrowText = eyebrow;
const eyebrowIcon = ICON_BY_VARIANT[variant];

// Иконки запросов клиента (24×24) — у каждой свой символ, а не одна на все.
const ISSUE_ICONS: Record<string, string> = {
  tray: 'M6 2h9l5 5v15H6zm8 8H9v2h5zm2 4H9v2h7z',
  droplet: 'M12 2s6 7.3 6 12a6 6 0 1 1-12 0c0-4.7 6-12 6-12z',
  jam: 'M12 2a10 10 0 1 0 .001 20.001A10 10 0 0 0 12 2zm3.5 13.1-1.4 1.4L12 14.4l-2.1 2.1-1.4-1.4L10.6 13l-2.1-2.1 1.4-1.4L12 11.6l2.1-2.1 1.4 1.4L13.4 13z',
  bolt: 'M13 2 3 14h7l-1 8 10-12h-7l1-8z',
  tag: TAG_D,
  contrast: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2v16a8 8 0 0 1 0-16z',
  wrench: ISSUE_D,
};
const issueIconPath = (key?: string) => ISSUE_ICONS[key ?? 'wrench'] ?? ISSUE_ICONS.wrench;

// Иконка «Информация» — для .info-note (переиспользуемый паттерн, см. tokens.css)
const INFO_D = 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z';
---

<section class:list={['section', { 'section--alt': alt }]} id={id}>
  <div class="container">
    <div class="section__head" data-animate>
      {eyebrowText && (
        <span class="eyebrow">
          <span class="eyebrow__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d={eyebrowIcon} /></svg>
          </span>
          {eyebrowText}
        </span>
      )}
      <h2 class="section__title">{nbsp(title)}</h2>
      {subtitle && <p class="section__sub">{nbsp(subtitle)}</p>}
    </div>

    {variant === 'issues' && (issuesLayout === 'split' ? (
      <Fragment>
      <div class="issues-split" data-animate>
        <div class="issues issues--split">
          {issues.map((it) => (
            <button class="issue" type="button" data-open-modal>
              <span class="issue__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d={issueIconPath(it.icon)} /></svg>
              </span>
              <span class="issue__body">
                <span class="issue__title">{nbsp(it.title)}</span>
                {it.desc && <span class="issue__desc">{nbsp(it.desc)}</span>}
              </span>
              {it.price && <span class="issue__price">{nbsp(it.price)}</span>}
            </button>
          ))}
        </div>
        <div class="issues-split__media">
          {image ? (
            <Img class="issues-split__img" src={image} alt={imageAlt} width={900} height={1205} loading="lazy" />
          ) : (
            <div class="issues-split__ph" role="img" aria-label="Место для фото">
              <svg viewBox="0 0 24 24" width="56" height="56" fill="currentColor" aria-hidden="true"><path d="M19 8h-1V3H6v5H5a3 3 0 0 0-3 3v6h4v3h12v-3h4v-6a3 3 0 0 0-3-3zM8 5h8v3H8V5zm8 14H8v-4h8v4zm3-5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/></svg>
            </div>
          )}
        </div>
      </div>
      {note && (
        <p class="info-note issues-split__note">
          <svg class="info-note__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={INFO_D} /></svg>
          <span>{nbsp(note)}</span>
        </p>
      )}
      </Fragment>
    ) : (
      <div class="issues" data-animate>
        {issues.map((it) => (
          <button class="issue" type="button" data-open-modal>
            <span class="issue__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d={issueIconPath(it.icon)} /></svg>
            </span>
            <span class="issue__body">
              <span class="issue__title">{nbsp(it.title)}</span>
              {it.desc && <span class="issue__desc">{nbsp(it.desc)}</span>}
              {it.price && <span class="issue__price">{nbsp(it.price)}</span>}
            </span>
          </button>
        ))}
      </div>
    ))}

    {variant === 'prices' && (
      <div class="prices" data-animate>
        <ul class="prices__list">
          {prices.map((row) => (
            <li class="price-row">
              <span class="price-row__name">
                {nbsp(row.service)}
                {row.note && <span class="price-row__note">{nbsp(row.note)}</span>}
              </span>
              <span class="price-row__dots" aria-hidden="true"></span>
              <span class="price-row__value">{nbsp(row.price)}</span>
            </li>
          ))}
        </ul>
        <div class="prices__cta">
          <button class="btn btn--primary" type="button" data-open-modal>{ctaText}</button>
        </div>
      </div>
    )}

    {variant === 'packages' && (
      <div class="packages" data-animate>
        {packages.map((p) => (
          <article class:list={['package', { 'package--featured': p.featured }]}>
            {p.featured && <span class="package__badge">Популярный</span>}
            <h3 class="package__name">{nbsp(p.name)}</h3>
            <div class="package__price">
              <span class="package__amount">{nbsp(p.price)}</span>
              {p.period && <span class="package__period">{nbsp(p.period)}</span>}
            </div>
            {p.note && <p class="package__note">{nbsp(p.note)}</p>}
            <ul class="package__features">
              {p.features.map((f) => (
                <li>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M9.6 16.2 5.4 12l-1.4 1.4 5.6 5.6 12-12L20.2 5.6z"/></svg>
                  <span>{nbsp(f)}</span>
                </li>
              ))}
            </ul>
            <button
              class:list={['btn', p.featured ? 'btn--primary' : 'btn--ghost', 'package__cta']}
              type="button"
              data-open-modal
            >{p.ctaText ?? 'Выбрать'}</button>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  /* ---------- variant: issues ---------- */
  .issues { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .issue {
    display: flex;
    align-items: flex-start;   /* иконка/цена по верху — не «плавают» при переносе заголовка */
    gap: 0.9rem;
    text-align: left;
    width: 100%;
    font: inherit;
    cursor: pointer;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.15rem 1.25rem;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .issue:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border)); }
  .issue:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
  .issue__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
  }
  .issue__body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .issue__title { font-weight: 700; }
  .issue__desc { font-size: 0.85rem; color: var(--color-text-light); line-height: 1.4; }
  /* цена — отдельным pill'ом под текстом: заголовок всегда получает полную ширину тела */
  .issue__price {
    align-self: flex-start;
    margin-top: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--color-on-primary);
    white-space: nowrap;
  }

  /* ---------- variant: issues, issuesLayout: split (список слева + фото справа, 60/40) ---------- */
  .issues-split { display: grid; grid-template-columns: 3fr 2fr; gap: clamp(1.5rem, 1rem + 2vw, 2.5rem); align-items: stretch; }
  /* grid + subgrid: колонка цены — одна общая ширина по самому длинному значению
     во всех строках, а не «своя» ширина под текст в каждой карточке по отдельности */
  .issues--split { display: grid; grid-template-columns: auto 1fr auto; row-gap: 0.75rem; }
  .issues--split .issue {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: center;
    column-gap: 0.9rem;
    background: var(--color-bg-section);
    border: none;
    box-shadow: none;
  }
  .issues--split .issue:hover { transform: none; box-shadow: none; background: color-mix(in srgb, var(--color-primary) 6%, var(--color-bg-section)); }
  .issues--split .issue__price { align-self: center; margin-top: 0; text-align: center; }
  .issues-split__media { position: relative; }
  .issues-split__img,
  .issues-split__ph {
    width: 100%;
    height: 100%;
    min-height: 360px;
    border-radius: var(--radius);
    object-fit: cover;
  }
  .issues-split__ph {
    display: flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--color-primary) 45%, var(--color-bg));
    background:
      linear-gradient(135deg,
        color-mix(in srgb, var(--color-primary) 10%, var(--color-bg)),
        color-mix(in srgb, var(--color-accent) 10%, var(--color-bg)));
    border: 1px solid var(--color-border);
  }
  .issues-split__note { margin-top: 1.25rem; }

  /* ---------- variant: prices ---------- */
  .prices { max-width: 760px; }
  .prices__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .price-row:first-child { padding-top: 0; }
  .price-row__name { display: flex; flex-direction: column; }
  .price-row__note { font-size: 0.8rem; color: var(--color-text-light); }
  .price-row__dots { flex: 1; border-bottom: 1px dotted var(--color-border); transform: translateY(-4px); min-width: 1.5rem; }
  .price-row__value { flex: none; font-weight: 800; color: var(--color-primary); white-space: nowrap; }
  .prices__cta { margin-top: 1.75rem; }

  /* ---------- variant: packages ---------- */
  .packages { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; align-items: start; }
  .package {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .package--featured {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
  }
  .package__badge {
    position: absolute;
    top: -0.7rem;
    right: 1.25rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
  }
  /* .package__name — h3, размер/вес от тега (см. tokens.css); раньше не было явного
     font-weight — держалось на дефолте браузера, теперь формально от базового правила */
  .package__price { display: flex; align-items: baseline; gap: 0.35rem; }
  .package__amount { font-size: clamp(1.6rem, 1.3rem + 1.5vw, 2.1rem); font-weight: 800; color: var(--color-text); }
  .package__period { color: var(--color-text-light); font-weight: 600; }
  .package__note { color: var(--color-text-light); font-size: 0.9rem; margin-top: -0.2rem; }
  .package__features { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; gap: 0.6rem; }
  .package__features li { display: flex; align-items: flex-start; gap: 0.55rem; font-size: 0.95rem; }
  .package__features svg { color: var(--color-primary); flex: none; margin-top: 0.15rem; }
  .package__cta { margin-top: auto; }

  /* ---------- адаптив ---------- */
  @media (max-width: 900px) {
    .issues:not(.issues--split), .packages { grid-template-columns: repeat(2, 1fr); }
    .issues-split { grid-template-columns: 1fr; }
    .issues-split__img, .issues-split__ph { min-height: 260px; max-height: 340px; }
  }

  /* Карусель на мобилке для карточных списков (issues/packages) — как в Reviews.
     prices — таблица, стекается вертикально, карусель не нужна.
     issuesLayout=split — уже 1 колонка, карусель не нужна, список остаётся стеком. */
  @media (max-width: 640px) {
    .issues:not(.issues--split), .packages {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: 82%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-bottom: 0.75rem;
    }
    .issues:not(.issues--split) .issue, .package { scroll-snap-align: center; }
    /* featured-карта на мобилке не «выпрыгивает» тенью за край скролла */
    .package--featured { margin-top: 0.7rem; }
  }
</style>
