---
/*
 * Целевой лид-блок «Лид-форма (акция/консультация)» из шаблонов заказчика.
 * РЕШЕНИЕ Андрея (2026-07-13): здесь форма ОТКРЫТА на странице (не модалка) — это
 * осознанное исключение из правила «форм на странице не держим» для ОДНОГО целевого
 * блока (правило было против форм-спама, а один акция-блок — норма). Внутри — sacred
 * LeadForm (контракт заявок не трогаем, темизируем только CSS). lead-form.js из
 * BaseLayout сам подцепит форму по data-form.
 *   split    — промо/акция слева, форма-карточка справа (акцентная подложка)
 *   centered — заголовок по центру, форма-карточка ниже (тёмная подложка)
 *   card     — промо и форма в одной светлой карточке на обычном фоне
 */
import { nbsp } from '../lib/typography';
import LeadForm from './LeadForm.astro';

interface Props {
  title: string;
  subtitle?: string;
  promo?: string;              // бейдж акции «Скидка 15% до конца дня»
  phone?: string;              // траст-строка «или позвоните»
  note?: string;               // мелкий текст у формы «Перезвоним за 5 минут»
  variant?: 'split' | 'centered' | 'card';
  submitText?: string;
  dataForm?: string;           // form_id (уникальный на странице)
  policyHref?: string;
  eyebrow?: string;
  id?: string;
}

const {
  title, subtitle, promo, phone, note,
  variant = 'split', submitText = 'Оставить заявку', dataForm = 'section',
  policyHref = '/privacy', eyebrow, id = 'lead',
} = Astro.props;

const telHref = phone ? 'tel:' + phone.replace(/[^\d+]/g, '') : null;

const PAPER_PLANE = 'M3 11 21 3l-8 18-2.5-6.5L3 11z';
---

<section class:list={['section', 'lead-sec', `lead-sec--${variant}`]} id={id}>
  <div class="container">
    <div class="lead-sec__inner" data-animate>
      <div class="lead-sec__promo">
        <span class="eyebrow lead-sec__eyebrow">
          <span class="eyebrow__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d={PAPER_PLANE} /></svg>
          </span>
          {eyebrow}
        </span>
        {promo && <span class="lead-sec__badge">{nbsp(promo)}</span>}
        <h2 class="lead-sec__title">{nbsp(title)}</h2>
        {subtitle && <p class="lead-sec__sub">{nbsp(subtitle)}</p>}
        {telHref && (
          <p class="lead-sec__phone-line">
            или позвоните <a href={telHref}>{phone}</a>
          </p>
        )}
      </div>

      <div class="lead-sec__card">
        {note && <p class="lead-sec__card-note">{nbsp(note)}</p>}
        <LeadForm dataForm={dataForm} submitText={submitText} policyHref={policyHref} layout="stacked" />
      </div>
    </div>
  </div>
</section>

<style>
  .lead-sec__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    align-items: center;
  }
  /* На split/centered секция сидит на цветной/тёмной подложке — иконка берёт цвет текста,
     а не фиксированный accent, иначе теряет контраст на тёмном фоне */
  .lead-sec__eyebrow { color: inherit; opacity: 0.75; }
  .lead-sec__eyebrow .eyebrow__icon { background: color-mix(in srgb, currentColor 20%, transparent); color: inherit; }
  .lead-sec__badge {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 700;
    font-size: 0.85rem;
  }
  /* .lead-sec__title — h2, размер/вес от тега (см. tokens.css) */
  .lead-sec__sub { margin-top: 0.75rem; font-size: 1.1rem; opacity: 0.85; max-width: 44ch; }
  .lead-sec__phone-line { margin-top: 1.1rem; opacity: 0.85; }
  .lead-sec__phone-line a { font-weight: 800; text-decoration: underline; white-space: nowrap; }

  .lead-sec__card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 1rem + 2vw, 2rem);
    box-shadow: var(--shadow-lg);
    color: var(--color-text);
  }
  .lead-sec__card-note { margin-bottom: 1rem; font-weight: 700; font-size: 1.05rem; }

  /* split — акцентная подложка, светлый текст промо */
  .lead-sec--split {
    background:
      radial-gradient(900px 500px at 100% 0%, color-mix(in srgb, var(--color-primary) 22%, transparent), transparent 60%),
      var(--color-primary);
    color: var(--color-on-primary);
  }
  .lead-sec--split .lead-sec__title { color: inherit; }

  /* centered — тёмная подложка, форма по центру ниже заголовка */
  .lead-sec--centered { background: var(--color-text); color: var(--color-bg); }
  .lead-sec--centered .lead-sec__title { color: inherit; }
  .lead-sec--centered .lead-sec__inner { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 2rem; }
  .lead-sec--centered .lead-sec__promo { max-width: 640px; }
  .lead-sec--centered .lead-sec__card { width: 100%; max-width: 440px; text-align: left; }

  /* card — промо и форма в одной светлой карточке на обычном фоне */
  .lead-sec--card { color: var(--color-text); }
  .lead-sec--card .lead-sec__inner {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    padding: clamp(1.75rem, 1.25rem + 3vw, 3rem);
  }
  .lead-sec--card .lead-sec__card { box-shadow: none; border: 0; padding: 0; }
  .lead-sec--card .lead-sec__badge { background: color-mix(in srgb, var(--color-accent) 12%, transparent); color: var(--color-accent-dark); }

  @media (max-width: 820px) {
    .lead-sec__inner { grid-template-columns: 1fr; gap: 1.75rem; }
    .lead-sec--card .lead-sec__inner { gap: 1.5rem; }
  }
</style>
