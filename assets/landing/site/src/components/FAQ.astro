---
/*
 * «FAQ» (Шаблон 2, поле маркетолога «Вопросы FAQ»). Аккордеон на нативных
 * <details>/<summary> — 0 JS. Скелет заморожен, LLM даёт items/variant.
 *   list    — одна колонка карточек-аккордеонов
 *   split   — заголовок секции слева (sticky), вопросы справа
 *   columns — две masonry-колонки (стек на мобилке)
 */
import { nbsp } from '../lib/typography';

interface QA { q: string; a: string; }

interface Props {
  title: string;
  subtitle?: string;
  items: QA[];
  variant?: 'list' | 'split' | 'columns';
  eyebrow?: string;
  alt?: boolean;
  id?: string;
}

const { title, subtitle, items, variant = 'list', eyebrow = 'Остались вопросы?', alt = false, id = 'faq' } = Astro.props;

const QUESTION = 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm.9 15.5h-1.8v-1.8h1.8zm1.9-6.8-.8.9c-.7.7-1.1 1.2-1.1 2.5h-1.8v-.5c0-1 .4-1.7 1.1-2.5l1.1-1.2c.3-.4.5-.8.5-1.3 0-1-.8-1.7-1.9-1.7-1 0-1.8.6-2 1.6l-1.9-.3C7.2 6.2 8.9 5 11 5c2.3 0 4 1.5 4 3.6 0 1-.4 1.7-1.2 2.6z';
---

<section class:list={['section', { 'section--alt': alt }]} id={id}>
  <div class:list={['container', 'faq', `faq--${variant}`]}>
    <div class:list={['section__head', 'faq__head']} data-animate>
      <span class="eyebrow">
        <span class="eyebrow__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d={QUESTION} /></svg>
        </span>
        {eyebrow}
      </span>
      <h2 class="section__title">{nbsp(title)}</h2>
      {subtitle && <p class="section__sub">{nbsp(subtitle)}</p>}
    </div>

    <div class="faq__list" data-animate>
      {items.map((qa) => (
        <details class="qa">
          <summary class="qa__q">
            <span>{nbsp(qa.q)}</span>
            <span class="qa__toggle" aria-hidden="true"></span>
          </summary>
          <p class="qa__a">{nbsp(qa.a)}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* ---------- variant: list ---------- */
  .faq--list .faq__list { max-width: 760px; display: flex; flex-direction: column; gap: 0.75rem; }

  /* ---------- variant: split ---------- */
  .faq--split { display: grid; grid-template-columns: minmax(240px, 1fr) 1.7fr; gap: clamp(1.5rem, 1rem + 2vw, 3rem); align-items: start; }
  .faq--split .faq__head { margin-bottom: 0; position: sticky; top: calc(var(--header-h) + 16px); }
  .faq--split .faq__list { display: flex; flex-direction: column; gap: 0.75rem; }

  /* ---------- variant: columns ---------- */
  .faq--columns .faq__list { columns: 2; column-gap: 1.25rem; }
  .faq--columns .qa { break-inside: avoid; margin-bottom: 0.75rem; }

  /* ---------- аккордеон ---------- */
  .qa {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition);
  }
  .qa[open] { border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border)); }

  .qa__q {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.35rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .qa__q::-webkit-details-marker { display: none; }
  .qa__q:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; border-radius: var(--radius); }
  .qa__q > span:first-child { flex: 1 1 auto; min-width: 0; }

  /* плюс → крест через CSS, без иконок-шрифтов */
  .qa__toggle { position: relative; width: 20px; height: 20px; flex: none; color: var(--color-primary); }
  .qa__toggle::before, .qa__toggle::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--transition);
  }
  .qa__toggle::before { width: 14px; height: 2px; }
  .qa__toggle::after { width: 2px; height: 14px; }
  .qa[open] .qa__toggle::after { transform: rotate(90deg); }

  .qa__a {
    padding: 0 1.35rem 1.2rem;
    color: var(--color-text-light);
    line-height: 1.55;
    max-width: 68ch;
  }

  /* ---------- адаптив ---------- */
  @media (max-width: 900px) {
    .faq--split { grid-template-columns: 1fr; }
    .faq--split .faq__head { position: static; margin-bottom: 1.5rem; }
    .faq--columns .faq__list { columns: 1; }
  }
</style>
