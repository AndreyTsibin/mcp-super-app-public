---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LeadFormSection from '../components/LeadFormSection.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import { placeholder as c } from '../data/placeholder';

/*
 * КАРКАС ГЛАВНОЙ — здесь только обязательный минимум: точка входа, целевое
 * действие, контакты. Это НЕ шаблон страницы и НЕ пример ниши: набор секций
 * между Hero и LeadFormSection ты набираешь сам под профиль ниши.
 *
 * Как собрать страницу:
 *   1. Профиль ниши и набор секций — docs/landing-spec.md.
 *   2. Все секции со всеми variant'ами вживую — страница /kit в превью.
 *   3. Контент — свой `src/data/<проект>.ts` со структурой из `placeholder.ts`.
 *      Здесь заменить импорт на него; сам placeholder.ts НЕ редактировать —
 *      на нём держатся /kit и /themes.
 *   4. Порядок секций чередует фон: alt={true} у каждой второй.
 *
 * Пока в пропсах видны маркеры `[[…]]` — страница не готова: валидатор
 * (.claude/check-landing.mjs) роняет проверку, если хоть один доехал до сборки.
 */
---

<BaseLayout
  title={`${c.hero.title} — ${c.brand}`}
  description={c.hero.subtitle}
  ogImage={c.hero.image}
  animations={false}
>
  <Header
    logo={c.brand}
    phone={c.phone}
    workHours={c.workHours}
    nav={c.nav}
    variant="classic"
    logoIcon={true}
  />

  <Hero
    title={c.hero.title}
    subtitle={c.hero.subtitle}
    status={c.hero.status}
    statusOffline={c.hero.statusOffline}
    bullets={c.hero.bullets}
    promo={c.hero.promo}
    promoNote={c.hero.promoNote}
    workHours={c.workHours}
    rating={c.hero.rating}
    phone={c.phone}
    image={c.hero.image}
    imageAlt={c.hero.imageAlt}
    variant="split"
  />

  {/*
    ↓ ЗДЕСЬ ТЕЛО СТРАНИЦЫ. Добери секции из библиотеки под свою нишу и её профиль
    (docs/landing-spec.md → «пул блоков»). Ничего не наследуй по инерции: набор
    для срочной услуги и для дорогой экспертной услуги разный.
  */}

  <LeadFormSection
    id="lead"
    variant="split"
    title="[[H2 у формы: что получит клиент, оставив заявку, 6–10 слов]]"
    subtitle="[[Подзаголовок: срок ответа и что будет дальше, 8–14 слов]]"
    promo={c.hero.promo}
    promoNote={c.hero.promoNote}
    phone={c.phone}
    dataForm="section"
  />

  <Contacts
    id="contacts"
    title={c.contacts.title}
    subtitle={c.contacts.subtitle}
    phone={c.phone}
    workHours={c.workHours}
    address={c.contacts.address}
    radius={c.contacts.radius}
    email={c.contacts.email}
    variant="map"
  />

  <Footer
    brand={c.brand}
    phone={c.phone}
    workHours={c.workHours}
    address={c.contacts.address}
    nav={c.nav}
    requisites={c.requisites}
    tagline="[[Строка в подвале: чем занимаетесь и где, 6–12 слов]]"
    variant="columns"
    logoIcon={true}
  />
</BaseLayout>
