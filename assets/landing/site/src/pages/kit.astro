---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import IssuesPricePackages from '../components/IssuesPricePackages.astro';
import PriceList from '../components/PriceList.astro';
import Promotions from '../components/Promotions.astro';
import LeadFormSection from '../components/LeadFormSection.astro';
import Benefits from '../components/Benefits.astro';
import Problems from '../components/Problems.astro';
import Steps from '../components/Steps.astro';
import Cases from '../components/Cases.astro';
import About from '../components/About.astro';
import Team from '../components/Team.astro';
import Certificates from '../components/Certificates.astro';
import Guarantee from '../components/Guarantee.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import { placeholder as c } from '../data/placeholder';

// ПОЛИГОН библиотеки: ВСЕ секции подряд, у некоторых по несколько variant'ов.
// Это витрина для обкатки и выбора секций, а НЕ шаблон страницы — боевая главная
// живёт в index.astro и берёт только нужное. В прод не идёт: noindex + удалять
// перед сдачей клиенту.
---

<BaseLayout
  title={`Полигон секций — ${c.brand}`}
  description="Витрина всех секций библиотеки для обкатки вариантов"
  noindex={true}
  animations={false}
>
  <Header
    logo={c.brand}
    phone={c.phone}
    workHours={c.workHours}
    nav={c.nav}
    variant="classic"
    logoIcon={true}
  />

  <Hero
    title={c.hero.title}
    subtitle={c.hero.subtitle}
    status={c.hero.status}
    statusOffline={c.hero.statusOffline}
    bullets={c.hero.bullets}
    promo={c.hero.promo}
    workHours={c.workHours}
    rating={c.hero.rating}
    phone={c.phone}
    image={c.hero.image}
    imageAlt={c.hero.imageAlt}
    variant="split"
  />

  {/* Шаблон 2: перечень услуг + лента брендов */}
  <Services
    id="services"
    alt={true}
    variant="split"
    eyebrow="[[Микро-вопрос клиента]]"
    title={c.services.title}
    subtitle={c.services.subtitle}
    items={c.services.items}
    brands={c.services.brands}
    image="/assets/img/placeholder-split.svg"
    imageAlt="[[Alt: что на кадре]]"
  />

  {/* Слот «/»: три variant'а подряд — для обкатки, в боевом шаблоне слот один */}
  <IssuesPricePackages
    id="issues"
    variant="issues"
    issuesLayout="split"
    title={c.issues.title}
    subtitle={c.issues.subtitle}
    issues={c.issues.items}
    image="/assets/img/placeholder-split.svg"
    imageAlt="[[Alt: что на кадре]]"
    note="[[Сноска под списком: что значит «от» в ценах и кто назовёт точную сумму]]"
  />

  <IssuesPricePackages
    id="prices"
    alt={true}
    variant="prices"
    title={c.prices.title}
    subtitle={c.prices.subtitle}
    prices={c.prices.items}
  />

  <IssuesPricePackages
    id="packages"
    variant="packages"
    title={c.packages.title}
    subtitle={c.packages.subtitle}
    packages={c.packages.items}
  />

  {/* Шаблон 2: полный прайс-лист с группами */}
  <PriceList
    id="pricelist"
    alt={true}
    variant="columns"
    title={c.priceList.title}
    subtitle={c.priceList.subtitle}
    groups={c.priceList.groups}
    note={c.priceList.note}
  />

  {/* Шаблон 3: акции — фирменная заливка (section--brand), третий фон ритма */}
  <Promotions
    id="promotions"
    variant="cards"
    brand={true}
    title={c.promotions.title}
    subtitle={c.promotions.subtitle}
    items={c.promotions.items}
  />

  {/* Шаблон 1: лид-форма(акция) — открытая форма на странице (решение Андрея) */}
  <LeadFormSection
    id="lead"
    variant="split"
    title="[[H2 у формы: что получит клиент, оставив заявку, 6–10 слов]]"
    subtitle="[[Подзаголовок: срок ответа и что будет дальше, 8–14 слов]]"
    note="[[Мелкий текст у формы: обещание по срокам]]"
    promo={c.hero.promo}
    phone={c.phone}
    dataForm="section"
  />

  <Benefits
    id="benefits"
    title={c.benefits.title}
    subtitle={c.benefits.subtitle}
    items={c.benefits.items}
    variant="cards"
  />

  {/* Боли ЦА — trust-профиль; variant split показывает пару «боль → решение» */}
  <Problems
    id="problems"
    variant="split"
    title={c.problems.title}
    subtitle={c.problems.subtitle}
    items={c.problems.items}
  />

  {/* Как работает — шаги процесса, нумерация автоматическая */}
  <Steps
    id="steps"
    alt={true}
    variant="timeline"
    title={c.steps.title}
    subtitle={c.steps.subtitle}
    items={c.steps.items}
  />

  {/* Кейсы — только реальные фото; в демо фото нет, показывает placeholder */}
  <Cases
    id="cases"
    variant="grid"
    title={c.cases.title}
    subtitle={c.cases.subtitle}
    items={c.cases.items}
  />

  {/* Шаблон 3: о компании (текст + цифры) */}
  <About
    id="about"
    alt={true}
    variant="stats"
    title={c.about.title}
    subtitle={c.about.subtitle}
    paragraphs={c.about.paragraphs}
    stats={c.about.stats}
  />

  {/* Шаблон 2: команда — карусель на мобилке (стандарт заказчика) */}
  <Team
    id="team"
    variant="cards"
    eyebrow="[[Микро-вопрос клиента]]"
    title={c.team.title}
    subtitle={c.team.subtitle}
    items={c.team.items}
  />

  {/* Шаблон 3: сертификаты — карусель на мобилке (стандарт заказчика) */}
  <Certificates
    id="certificates"
    alt={true}
    variant="grid"
    title={c.certificates.title}
    subtitle={c.certificates.subtitle}
    items={c.certificates.items}
  />

  {/* Гарантия — акцентная панель доверия */}
  <Guarantee
    id="guarantee"
    variant="banner"
    title={c.guarantee.title}
    badge={c.guarantee.badge}
    text={c.guarantee.text}
    items={c.guarantee.items}
  />

  <Reviews
    id="reviews"
    title={c.reviews.title}
    subtitle={c.reviews.subtitle}
    items={c.reviews.items}
    variant="grid"
  />

  {/* Шаблон 2: FAQ — нативный <details>-аккордеон, 0 JS */}
  <FAQ
    id="faq"
    variant="split"
    title={c.faq.title}
    subtitle={c.faq.subtitle}
    items={c.faq.items}
  />

  <Contacts
    id="contacts"
    alt={true}
    title={c.contacts.title}
    subtitle={c.contacts.subtitle}
    phone={c.phone}
    workHours={c.workHours}
    address={c.contacts.address}
    radius={c.contacts.radius}
    email={c.contacts.email}
    variant="map"
  />

  <Footer
    brand={c.brand}
    phone={c.phone}
    workHours={c.workHours}
    address={c.contacts.address}
    nav={c.nav}
    requisites={c.requisites}
    tagline="[[Строка в подвале: чем занимаетесь и где, 6–12 слов]]"
    variant="columns"
    logoIcon={true}
  />
</BaseLayout>
