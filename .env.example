# Скопируй этот файл в .env и впиши свой ключ после знака "=".
# .env игнорируется git (см. .gitignore) — в репозиторий он не попадёт.
#
# Ключ без пометки `# optional` считается обязательным: при старте сервер
# сверяет твой .env с этим образцом и предупреждает, если обязательного ключа
# не хватает (после обновления тут может появиться новый).

# Обязателен для create_image. Где взять: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Необязателен: второй движок картинок (Magnific Mystic), нужен план
# Business/Enterprise — https://www.magnific.com/user/api-keys
# Без этого ключа у create_image просто нет провайдера magnific, остальное работает.
# optional
MAGNIFIC_API_KEY=
