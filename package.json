{
  "name": "mcp-super-app",
  "version": "0.6.1",
  "description": "Personal MCP server unifying project bootstrap, skills, landings, guard and image generation.",
  "type": "module",
  "private": true,
  "bin": {
    "mcp-super-app": "dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-stamp.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide-static": "^1.24.0",
    "sharp": "^0.35.3",
    "simple-icons": "^16.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
